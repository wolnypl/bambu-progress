# Copy to /etc/bambu-progress.env, fill the values, then set mode 600.
# systemd passes each listed value to `docker run` with -e.
BAMBU_ACCESS_TOKEN=
BAMBU_USER_ID=
BAMBU_DEVICE_ID=
BAMBU_MQTT_HOST=us.mqtt.bambulab.com
BAMBU_TIMEOUT_SECONDS=20

HA_MQTT_HOST=
HA_MQTT_PORT=1883
HA_MQTT_USERNAME=
HA_MQTT_PASSWORD=
HA_MQTT_TLS=false
HA_MQTT_DISCOVERY_PREFIX=homeassistant
